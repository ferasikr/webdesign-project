
<article class="job-card">
  <div class="job-card__top">
    <picture class="job-card__logo">
      <source
        type="image/webp"
        srcset="images/companies/<%= job.company.toLowerCase() %>-1x.webp 1x, images/companies/<%= job.company.toLowerCase() %>-2x.webp 2x"
      />
      <img
        class="job-card__logo-img"
        src="images/companies/<%= job.company.toLowerCase() %>-1x.png"
        srcset="images/companies/<%= job.company.toLowerCase() %>-2x.png 2x"
        width="44"
        height="44"
        alt="<%= job.company %> logo"
        loading="lazy"
      />
    </picture>

    <div class="job-card__info">
      <p class="job-card__meta"><%= job.company %> · <time datetime="<%= job.postedAt %>"><%= job.posted %></time></p>
      <h3 class="job-card__title"><a class="job-card__link" href="job-details.html"><%= job.title %></a></h3>
      <p class="job-card__location"><%= job.location %></p>
      <% if (locals.showDescription) { %>
      <p class="job-card__description"><%= job.description %></p>
      <% } %>
    </div>

    <button class="job-card__save" type="button" aria-label="Save <%= job.title %> at <%= job.company %>"></button>
  </div>

  <div class="job-card__bottom">
    <ul class="job-card__tags">
      <% job.tags.forEach(tag => { %>
      <li class="job-card__tag"><%= tag %></li>
      <% }) %>
    </ul>
    <p class="job-card__salary"><%= job.salary %></p>
  </div>
</article>