

<form class="search" role="search" action="jobs.html" method="get">
    <input class="search__input" type="search" name="q" placeholder="Job title, skill or company" aria-label="Job title, skill or company" data-i18n-placeholder="search.queryPlaceholder" data-i18n-aria-label="search.queryLabel">
    <input class="search__input" type="text" name="location" placeholder="Anywhere / Remote" aria-label="Location" data-i18n-placeholder="search.locationPlaceholder" data-i18n-aria-label="search.locationLabel">
    <button class="button button--primary search__submit" type="submit" data-i18n="search.submit">Search jobs</button>
</form>