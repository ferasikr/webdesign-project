<a class="focus__link" href="jobs.html?category=<%= area.slug %>">
  <svg class="focus__icon" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
    <%- area.icon %>
  </svg>
  <div class="focus__text">
    <span class="focus__name"><%= area.name %></span>
    <span class="focus__count"><%= area.roles %></span>
  </div>
</a>