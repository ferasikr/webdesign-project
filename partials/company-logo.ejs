<% const logoSlug = company.toLowerCase(); %>
<picture class="<%= className %>">
  <source
    type="image/webp"
    srcset="images/companies/<%= logoSlug %>-1x.webp 1x, images/companies/<%= logoSlug %>-2x.webp 2x"
  />
  <img
    class="<%= className %>-img"
    src="images/companies/<%= logoSlug %>-1x.png"
    srcset="images/companies/<%= logoSlug %>-2x.png 2x"
    width="44"
    height="44"
    alt="<%= company %> logo"
    loading="lazy"
  />
</picture>